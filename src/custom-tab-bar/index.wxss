.custom-tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 34px;
  padding-bottom: max(env(safe-area-inset-bottom), 34px);
  pointer-events: none;
}

.custom-tab-bar__capsule {
  display: flex;
  align-items: center;
  justify-content: space-evenly;
  width: 154px;
  height: 68px;
  background: #f6f6f6;
  border-radius: 32px;
  box-shadow: 0 0 34px 0 rgba(0, 0, 0, 0.25);
  pointer-events: auto;
}

.custom-tab-bar__item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
}

.custom-tab-bar__icon {
  width: 20px;
  height: 20px;
}
