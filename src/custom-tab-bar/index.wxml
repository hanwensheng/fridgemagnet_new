<view class="custom-tab-bar" wx:if="{{!hidden}}">
  <view class="custom-tab-bar__capsule">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      class="custom-tab-bar__item"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <image
        class="custom-tab-bar__icon"
        src="{{selected === index ? item.activeIcon : item.icon}}"
        mode="aspectFit"
      />
    </view>
  </view>
</view>
